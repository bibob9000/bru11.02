<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".ui.ForgotPasswordActivity">

    <!-- Decorative glow -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-50dp"
        android:background="@drawable/glow_circle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center_vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/forgotttextView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Забули пароль?"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/forgotttextView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="36dp"
                android:layout_marginTop="8dp"
                android:text="Введіть вашу електронну пошту для відновлення" />

            <!-- Card with form -->
            <LinearLayout
                android:id="@+id/forgotCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Електронна пошта"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/forgotEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxStrokeColor="@color/input_stroke_selector"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/forgotEmailAddressField"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:hint="example@mail.com" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Send OTP button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_forgot"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/gradient_button"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                android:text="Надіслати код"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:elevation="8dp"
                android:stateListAnimator="@null" />

            <!-- Gradient divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:layout_marginHorizontal="40dp"
                android:background="@drawable/divider_gradient" />

            <!-- Back to sign in -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/forgottextview16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:text="Згадали пароль? " />

                <TextView
                    android:onClick="signin2"
                    android:id="@+id/forgottextview17"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:text="Увійти" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
