<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".ui.LogInActivity">

    <!-- Decorative glow effect top-right -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/glow_circle" />

    <!-- Decorative glow effect bottom-left -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        android:background="@drawable/glow_circle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center_vertical">

            <!-- Title section -->
            <TextView
                android:id="@+id/logintextView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="З поверненням!"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:layout_marginTop="40dp" />

            <TextView
                android:id="@+id/logintextView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="36dp"
                android:text="Введіть пошту та пароль для входу"
                android:textSize="16sp"
                android:textColor="@color/text_secondary" />

            <!-- Card with form fields -->
            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="24dp">

                <!-- Email field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Електронна пошта"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/logInEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:boxStrokeColor="@color/input_stroke_selector"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="example@mail.com"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Пароль"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/LoginPasswordTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_secondary"
                    app:boxStrokeColor="@color/input_stroke_selector"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="********"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot password link -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Забули пароль?"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:onClick="forgot" />
                </RelativeLayout>

            </LinearLayout>

            <!-- Sign In button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_signin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="Увійти"
                android:background="@drawable/gradient_button"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:elevation="8dp"
                android:stateListAnimator="@null" />

            <!-- Gradient divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:layout_marginHorizontal="40dp"
                android:background="@drawable/divider_gradient" />

            <!-- Sign up link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/logintextView16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Немає аккаунту? "
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/logintextView17"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Створити"
                    android:textSize="15sp"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:onClick="signup" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
