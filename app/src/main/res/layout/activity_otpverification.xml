<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".ui.OTPVerificationActivity">

    <!-- Decorative glow -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"
        android:background="@drawable/glow_circle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center_vertical">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Верифікація OTP"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Введіть 6-значний код, надісланий на вашу пошту"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="36dp"
                android:layout_marginTop="8dp" />

            <!-- Card with PIN input -->
            <LinearLayout
                android:id="@+id/otpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="28dp"
                android:gravity="center">

                <com.chaos.view.PinView
                    android:id="@+id/pinView"
                    android:layout_width="wrap_content"
                    android:layout_height="50sp"
                    app:hideLineWhenFilled="false"
                    android:cursorVisible="true"
                    android:inputType="number"
                    app:itemCount="6"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    app:lineColor="@color/primary"
                    app:itemSpacing="10sp" />

                <!-- Resend timer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Не отримали код? "
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/resendAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="resend"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent" />
                </LinearLayout>

            </LinearLayout>

            <!-- Set New Password button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/SetNewPass"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/gradient_button"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                android:text="Підтвердити"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:elevation="8dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
